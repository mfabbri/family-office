  "limitations": [
    "Covers ordinary financial income/capital gains, qualified government instruments declared upstream, stamp duty and ordinary IVAFE for products financial assets.",
    "Does not cover PIR, crypto-assets, qualified shareholdings, real-estate funds, foreign tax credits, full tax return preparation, foreign taxation, IVAFE blacklist uplift or current-account fixed/minimum cases.",
    "Expected returns, turnover, costs, realized gains, unrealized gains and available loss carryforwards must be declared upstream.",
    "OICR government-bond quota is not inferred; use an explicit government_qualified portion only when documented."
  ],
  "tax_rates": {
    "ordinary_financial": "0.2600",
    "government_qualified": "0.1250"
  },
  "wealth_taxes": {
    "domestic_stamp_duty": {
