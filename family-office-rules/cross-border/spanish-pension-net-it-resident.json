  "limitations": [
    "Calculates only a deterministic gross-to-net bridge for Spanish pension streams already classified by it-es-pension-tax-classification/v1.",
    "Uses Italian national gross IRPEF brackets only; does not calculate deductions, regional/municipal surtaxes, advances, refunds, Spanish tax from rates or full return filing outcomes.",
    "Foreign tax credit requires explicit definitive foreign tax and declared credit applicability; provisional or refundable withholding must become a data gap.",
    "Optional new-resident pension regimes, Article 24-ter TUIR, and professional advice workflows are out of scope."
  ],
  "credit_method": {
    "method_id": "it.tuir-art165.incremental-limit.v1",
    "requires_definitive_foreign_tax": true,
    "foreign_tax_credit_formula": "min(definitive_foreign_tax, italian_incremental_tax_on_foreign_pension, italian_tax_after_pension * foreign_income / total_taxable_income, declared_credit_capacity)",
    "declared_credit_capacity_required": false
  },
