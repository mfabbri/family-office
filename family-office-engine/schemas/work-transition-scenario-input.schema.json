{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work Transition Scenario Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "household_id", "as_of_date", "plan_start_date", "plan_end_date", "work_phases"],
  "properties": {
    "schema_version": {"const": "work-transition-scenario-input/v1"},
    "record_type": {"const": "WorkTransitionScenarioInput"},
    "household_id": {"type": "string", "minLength": 1},
    "as_of_date": {"type": "string", "format": "date"},
    "plan_start_date": {"type": "string", "format": "date"},
    "plan_end_date": {"type": "string", "format": "date"},
    "work_phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase_id", "member_id", "start_date", "end_date", "status", "fte", "compensation_policy_ref", "contribution_benefit_policy_ref", "contractual_constraints", "provenance"],
        "properties": {
          "phase_id": {"type": "string", "minLength": 1},
          "member_id": {"type": "string", "minLength": 1},
          "start_date": {"type": "string", "format": "date"},
          "end_date": {"type": "string", "format": "date"},
          "status": {"enum": ["full_time", "part_time", "not_working"]},
          "fte": {"type": "number", "minimum": 0, "maximum": 1},
          "compensation_policy_ref": {"type": "string", "minLength": 1},
          "contribution_benefit_policy_ref": {"type": "string", "minLength": 1},
          "contractual_constraints": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["constraint_id", "constraint_type", "description"],
              "properties": {
                "constraint_id": {"type": "string", "minLength": 1},
                "constraint_type": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1},
                "binding": {"type": "string"}
              }
            }
          },
          "provenance": {
            "type": "object",
            "required": ["origin"],
            "properties": {"origin": {"type": "string", "minLength": 1}},
            "additionalProperties": false
          }
        }
      }
    },
    "declared_timeline_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member_id", "start_date", "end_date", "reason"],
        "properties": {
          "member_id": {"type": "string", "minLength": 1},
          "start_date": {"type": "string", "format": "date"},
          "end_date": {"type": "string", "format": "date"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
