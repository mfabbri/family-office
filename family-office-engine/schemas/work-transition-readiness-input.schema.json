{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work Transition Readiness Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "household_id", "as_of_date", "household_members", "required_inputs", "sources"],
  "properties": {
    "schema_version": {"const": "work-transition-readiness-input/v1"},
    "record_type": {"const": "WorkTransitionReadinessInput"},
    "household_id": {"type": "string", "minLength": 1},
    "as_of_date": {"type": "string", "format": "date"},
    "household_members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "freshness_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_max_age_days": {"type": "integer", "minimum": 0},
        "max_age_days_by_category": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "required_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input_id", "category"],
        "properties": {
          "input_id": {"type": "string", "minLength": 1},
          "category": {"enum": ["employment_income", "spouse_income", "expenses", "net_worth", "liquidity", "rita_complementary_pension", "inps_pension", "spain_eu_pension", "other_income"]},
          "member_id": {"type": "string"},
          "required": {"type": "boolean"},
          "accepted_value_basis": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["gross", "net", "mixed", "not_applicable"]}},
          "required_period": {"$ref": "#/$defs/period"},
          "requires_stream_bounds": {"type": "boolean"},
          "requires_liquid_asset": {"type": "boolean"}
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "input_id", "category", "source_kind", "path", "expected_schema_versions", "value_basis", "binding_pointer", "provenance"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "input_id": {"type": "string", "minLength": 1},
          "category": {"enum": ["employment_income", "spouse_income", "expenses", "net_worth", "liquidity", "rita_complementary_pension", "inps_pension", "spain_eu_pension", "other_income"]},
          "member_id": {"type": "string"},
          "source_kind": {"enum": ["documentary", "normalized", "derived", "manual"]},
          "path": {"type": "string", "minLength": 1},
          "as_of_date": {"type": "string", "format": "date"},
          "expected_schema_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "value_basis": {"enum": ["gross", "net", "mixed", "not_applicable"]},
          "binding_pointer": {"type": "string", "pattern": "^/"},
          "period": {"$ref": "#/$defs/period"},
          "stream_start_date": {"type": "string", "format": "date"},
          "stream_end_date": {"type": "string", "format": "date"},
          "liquidity_tier": {"enum": ["immediate", "short_term", "notice_required", "locked_until_date", "illiquid", "unknown"]},
          "coverage_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "provenance": {"type": "object", "required": ["origin"], "properties": {"origin": {"type": "string", "minLength": 1}}, "additionalProperties": true}
        }
      }
    }
  },
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date"],
      "properties": {"start_date": {"type": "string", "format": "date"}, "end_date": {"type": "string", "format": "date"}}
    }
  }
}
