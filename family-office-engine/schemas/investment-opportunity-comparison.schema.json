{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Investment Opportunity Comparison Snapshot V1",
  "type": "object",
  "required": ["schema_version", "record_type", "status", "primary", "comparisons", "data_gaps", "summary", "reproducibility"],
  "properties": {
    "schema_version": {"const": "investment-opportunity-comparison/v1"},
    "record_type": {"const": "InvestmentOpportunityComparisonSnapshot"},
    "status": {"enum": ["complete", "partial"]},
    "comparisons": {"type": "array"},
    "data_gaps": {"type": "array"},
    "summary": {"type": "object", "required": ["automatic_ranking_produced", "dimensions_kept_separate"]},
    "reproducibility": {"type": "object", "required": ["hash_algorithm", "content_hash"]}
  }
}
